<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farmlog.dataquality.mapper.DataQualityMapper">
  <resultMap id="issue" type="com.farmlog.dataquality.entity.IssueRow">
    <id property="id" column="id"/><result property="organizationId" column="organization_id"/><result property="farmId" column="farm_id"/><result property="farmName" column="farm_name"/>
    <result property="zoneId" column="zone_id"/><result property="zoneName" column="zone_name"/><result property="issueDate" column="issue_date"/><result property="issueType" column="issue_type"/>
    <result property="issueStatus" column="issue_status"/><result property="severity" column="severity"/><result property="title" column="title"/><result property="description" column="description"/>
    <result property="detectedBy" column="detected_by"/><result property="assignedManagerUserId" column="assigned_manager_user_id"/><result property="relatedRefType" column="related_ref_type"/><result property="relatedRefId" column="related_ref_id"/>
    <result property="resolutionRefType" column="resolution_ref_type"/><result property="resolutionRefId" column="resolution_ref_id"/><result property="farmerConfirmStatus" column="farmer_confirm_status"/>
    <result property="createdBy" column="created_by"/><result property="createdAt" column="created_at"/><result property="updatedAt" column="updated_at"/><result property="closedAt" column="closed_at"/><result property="version" column="version"/>
  </resultMap>
  <resultMap id="followup" type="com.farmlog.dataquality.entity.FollowupRow"><id property="id" column="id"/><result property="organizationId" column="organization_id"/><result property="farmId" column="farm_id"/><result property="issueId" column="issue_id"/><result property="managerUserId" column="manager_user_id"/><result property="managerName" column="manager_name"/><result property="contactMethod" column="contact_method"/><result property="followupStatus" column="followup_status"/><result property="contentSummary" column="content_summary"/><result property="nextActionAt" column="next_action_at"/><result property="clientRequestId" column="client_request_id"/><result property="createdAt" column="created_at"/></resultMap>
  <sql id="issueColumns">SELECT q.*,f.name farm_name,z.name zone_name FROM data_quality_issue q JOIN farm f ON f.id=q.farm_id LEFT JOIN farm_zone z ON z.id=q.zone_id</sql>
  <sql id="filters"> WHERE q.farm_id=#{farmId}<if test="issueType!=null"> AND q.issue_type=#{issueType}</if><if test="issueStatus!=null"> AND q.issue_status=#{issueStatus}</if><if test="severity!=null"> AND q.severity=#{severity}</if><if test="farmerConfirmStatus!=null"> AND q.farmer_confirm_status=#{farmerConfirmStatus}</if></sql>
  <select id="findPage" resultMap="issue"><include refid="issueColumns"/><include refid="filters"/> ORDER BY ${orderBy} ${direction},q.id ${direction} LIMIT #{size} OFFSET #{offset}</select>
  <select id="countPage" resultType="long">SELECT COUNT(*) FROM data_quality_issue q<include refid="filters"/></select>
  <select id="findById" resultMap="issue"><include refid="issueColumns"/> WHERE q.farm_id=#{farmId} AND q.id=#{id}</select>
  <select id="findIssueAttachments" resultType="com.farmlog.dataquality.entity.AttachmentSummaryRow">SELECT id,original_file_name,content_type,file_size,created_at FROM attachment_file WHERE farm_id=#{farmId} AND ref_type='DATA_QUALITY_ISSUE' AND ref_id=#{issueId} AND deleted_at IS NULL ORDER BY created_at,id</select>
  <insert id="insertIssue" useGeneratedKeys="true" keyProperty="id">INSERT INTO data_quality_issue(organization_id,farm_id,zone_id,issue_date,issue_type,issue_status,severity,title,description,detected_by,assigned_manager_user_id,related_ref_type,related_ref_id,farmer_confirm_status,created_by,created_at,version) VALUES(#{organizationId},#{farmId},#{zoneId},#{issueDate},#{issueType},#{issueStatus},#{severity},#{title},#{description},#{detectedBy},#{assignedManagerUserId},#{relatedRefType},#{relatedRefId},#{farmerConfirmStatus},#{createdBy},#{createdAt},0)</insert>
  <update id="updateStatus">UPDATE data_quality_issue SET issue_status=#{status},updated_by=#{userId},updated_at=#{now},closed_by=CASE WHEN #{status} IN ('RESOLVED','CLOSED') THEN #{userId} ELSE NULL END,closed_at=CASE WHEN #{status} IN ('RESOLVED','CLOSED') THEN #{now} ELSE NULL END,version=version+1 WHERE farm_id=#{farmId} AND id=#{id} AND version=#{version}</update>
  <select id="findFollowups" resultMap="followup">SELECT l.*,u.display_name manager_name FROM data_followup_log l JOIN users u ON u.id=l.manager_user_id WHERE l.farm_id=#{farmId} AND l.issue_id=#{issueId} ORDER BY l.created_at DESC,l.id DESC LIMIT #{size} OFFSET #{offset}</select>
  <select id="countFollowups" resultType="long">SELECT COUNT(*) FROM data_followup_log WHERE farm_id=#{farmId} AND issue_id=#{issueId}</select>
  <select id="findFollowupByRequest" resultMap="followup">SELECT l.*,u.display_name manager_name FROM data_followup_log l JOIN users u ON u.id=l.manager_user_id WHERE l.issue_id=#{issueId} AND l.client_request_id=#{clientRequestId}</select>
  <select id="findFollowupByRequestForUpdate" resultMap="followup">SELECT l.*,u.display_name manager_name FROM data_followup_log l JOIN users u ON u.id=l.manager_user_id WHERE l.issue_id=#{issueId} AND l.client_request_id=#{clientRequestId} FOR UPDATE</select>
  <select id="findFollowupById" resultMap="followup">SELECT l.*,u.display_name manager_name FROM data_followup_log l JOIN users u ON u.id=l.manager_user_id WHERE l.farm_id=#{farmId} AND l.id=#{id}</select>
  <insert id="insertFollowup" useGeneratedKeys="true" keyProperty="id">INSERT INTO data_followup_log(organization_id,farm_id,issue_id,manager_user_id,contact_method,followup_status,content_summary,next_action_at,client_request_id,created_at) VALUES(#{organizationId},#{farmId},#{issueId},#{managerUserId},#{contactMethod},#{followupStatus},#{contentSummary},#{nextActionAt},#{clientRequestId},#{createdAt})</insert>
  <insert id="insertAudit">INSERT INTO audit_log(organization_id,farm_id,actor_user_id,action,target_type,target_id,detail_json,created_at) VALUES(#{organizationId},#{farmId},#{actorUserId},#{action},#{targetType},#{targetId},#{detailJson},#{now})</insert>
</mapper>
