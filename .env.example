# Farmlog API 환경 변수 예시
# 실제 값을 담은 .env 파일은 절대 커밋하지 않는다 (.gitignore에 등록됨).
# 사용법: cp .env.example .env  (Windows: copy .env.example .env) 후 값 채우기

# ---- DB 접속 정보 (기존 서버 MariaDB 사용) ----
DB_HOST=37.16.25.46
DB_PORT=3306
DB_NAME=farming
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10

# ---- JWT ----
# 운영/개발 공유 환경에서는 반드시 32자 이상의 임의 문자열로 교체할 것
JWT_SECRET=CHANGE_ME_DEV_ONLY_farmlog_local_secret_key_please_override_in_env
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14

# ---- 비밀번호 재설정 링크 (SMTP 미구성 — 콘솔 로그로 대체 발송) ----
# 웹 저장소의 실제 라우트(app/web/src/app/routes.tsx)와 반드시 일치시킬 것
PASSWORD_RESET_BASE_URL=http://localhost:5173/password-reset

# ---- 농장 초대 링크 (SMTP/outbox 미구성 — 생성 직후 콘솔 로그로 1회 전달) ----
INVITATION_WEB_BASE_URL=http://localhost:5173

# ---- 파일 업로드 (로컬 볼륨) ----
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10

# ---- 리포트 내보내기 (Docker에서는 farmlog-exports 볼륨에 보존) ----
EXPORT_ROOT_DIR=./exports
EXPORT_RETENTION_DAYS=7
EXPORT_XLSX_MAX_ROWS=200000
EXPORT_PDF_MAX_ROWS=5000
EXPORT_LEASE_MINUTES=10
EXPORT_MAX_ATTEMPTS=3
EXPORT_POLL_DELAY_MS=1000

# ---- CORS (PC 웹 dev 서버, 모바일 Expo dev 서버) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# ---- 서버 ----
SERVER_PORT=8080
# local/dev/test만 초대 원문 링크 INFO 전달 구현을 활성화한다.
# prod는 SMTP/outbox InvitationDelivery bean을 별도로 제공하지 않으면 의도적으로 기동 실패한다.
SPRING_PROFILES_ACTIVE=local
