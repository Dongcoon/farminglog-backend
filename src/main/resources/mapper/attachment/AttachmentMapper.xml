<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farmlog.attachment.mapper.AttachmentMapper">
 <resultMap id="attachment" type="com.farmlog.attachment.entity.AttachmentRow"><id property="id" column="id"/><result property="organizationId" column="organization_id"/><result property="farmId" column="farm_id"/><result property="refType" column="ref_type"/><result property="refId" column="ref_id"/><result property="clientFileId" column="client_file_id"/><result property="originalFileName" column="original_file_name"/><result property="storedFileName" column="stored_file_name"/><result property="contentType" column="content_type"/><result property="fileSize" column="file_size"/><result property="storagePath" column="storage_path"/><result property="createdBy" column="created_by"/><result property="createdByName" column="created_by_name"/><result property="createdAt" column="created_at"/><result property="deletedAt" column="deleted_at"/><result property="version" column="version"/></resultMap>
 <resultMap id="batch" type="com.farmlog.attachment.entity.PhotoBatchRow"><id property="id" column="id"/><result property="organizationId" column="organization_id"/><result property="farmId" column="farm_id"/><result property="ownerUserId" column="owner_user_id"/><result property="careAssignmentId" column="care_assignment_id"/><result property="clientRequestId" column="client_request_id"/><result property="issueDate" column="issue_date"/><result property="zoneId" column="zone_id"/><result property="estimatedRecordType" column="estimated_record_type"/><result property="memo" column="memo"/><result property="fileCount" column="file_count"/><result property="status" column="status"/><result property="commitRequestId" column="commit_request_id"/><result property="issueId" column="issue_id"/><result property="expiresAt" column="expires_at"/><result property="createdAt" column="created_at"/><result property="committedAt" column="committed_at"/></resultMap>
 <resultMap id="batchFile" type="com.farmlog.attachment.entity.PhotoBatchFileRow"><id property="id" column="id"/><result property="batchId" column="batch_id"/><result property="clientFileId" column="client_file_id"/><result property="originalFileName" column="original_file_name"/><result property="storedFileName" column="stored_file_name"/><result property="contentType" column="content_type"/><result property="fileSize" column="file_size"/><result property="stagingPath" column="staging_path"/><result property="status" column="status"/><result property="uploadedAt" column="uploaded_at"/></resultMap>
 <sql id="attachmentColumns">SELECT a.*,u.display_name created_by_name FROM attachment_file a JOIN users u ON u.id=a.created_by</sql>
 <select id="findByRef" resultMap="attachment"><include refid="attachmentColumns"/> WHERE a.farm_id=#{farmId} AND a.ref_type=#{refType} AND a.ref_id=#{refId} AND a.deleted_at IS NULL ORDER BY a.created_at,a.id</select>
 <select id="findById" resultMap="attachment"><include refid="attachmentColumns"/> WHERE a.farm_id=#{farmId} AND a.id=#{id} AND a.deleted_at IS NULL</select>
 <select id="findByClientFile" resultMap="attachment"><include refid="attachmentColumns"/> WHERE a.farm_id=#{farmId} AND a.ref_type=#{refType} AND a.ref_id=#{refId} AND a.client_file_id=#{clientFileId} AND a.deleted_at IS NULL</select>
 <select id="findByClientFileForUpdate" resultMap="attachment"><include refid="attachmentColumns"/> WHERE a.farm_id=#{farmId} AND a.ref_type=#{refType} AND a.ref_id=#{refId} AND a.client_file_id=#{clientFileId} AND a.deleted_at IS NULL FOR UPDATE</select>
 <select id="countByRef" resultType="long">SELECT COUNT(*) FROM attachment_file WHERE farm_id=#{farmId} AND ref_type=#{refType} AND ref_id=#{refId} AND deleted_at IS NULL</select>
 <insert id="insertAttachment" useGeneratedKeys="true" keyProperty="id">INSERT INTO attachment_file(organization_id,farm_id,ref_type,ref_id,client_file_id,original_file_name,stored_file_name,content_type,file_size,storage_type,storage_path,created_by,created_at,version) VALUES(#{organizationId},#{farmId},#{refType},#{refId},#{clientFileId},#{originalFileName},#{storedFileName},#{contentType},#{fileSize},'LOCAL',#{storagePath},#{createdBy},#{createdAt},0)</insert>
 <update id="softDelete">UPDATE attachment_file SET deleted_at=#{now},version=version+1 WHERE farm_id=#{farmId} AND id=#{id} AND deleted_at IS NULL AND version=#{version}</update>
 <select id="findBatchByRequest" resultMap="batch">SELECT * FROM photo_upload_batch WHERE farm_id=#{farmId} AND owner_user_id=#{ownerUserId} AND client_request_id=#{clientRequestId}</select>
 <select id="findBatch" resultMap="batch">SELECT * FROM photo_upload_batch WHERE farm_id=#{farmId} AND owner_user_id=#{ownerUserId} AND id=#{id}</select>
 <select id="lockBatch" resultMap="batch">SELECT * FROM photo_upload_batch WHERE farm_id=#{farmId} AND owner_user_id=#{ownerUserId} AND id=#{id} FOR UPDATE</select>
 <insert id="insertBatch">INSERT INTO photo_upload_batch(id,organization_id,farm_id,owner_user_id,care_assignment_id,client_request_id,issue_date,zone_id,estimated_record_type,memo,file_count,status,expires_at,created_at) VALUES(#{id},#{organizationId},#{farmId},#{ownerUserId},#{careAssignmentId},#{clientRequestId},#{issueDate},#{zoneId},#{estimatedRecordType},#{memo},#{fileCount},'UPLOADING',#{expiresAt},#{createdAt})</insert>
 <select id="findBatchFiles" resultMap="batchFile">SELECT * FROM photo_upload_file WHERE batch_id=#{batchId} AND status='UPLOADED' ORDER BY uploaded_at,id</select>
 <select id="findBatchFile" resultMap="batchFile">SELECT * FROM photo_upload_file WHERE batch_id=#{batchId} AND client_file_id=#{clientFileId}</select>
 <select id="findBatchFileForUpdate" resultMap="batchFile">SELECT * FROM photo_upload_file WHERE batch_id=#{batchId} AND client_file_id=#{clientFileId} FOR UPDATE</select>
 <insert id="insertBatchFile" useGeneratedKeys="true" keyProperty="id">INSERT INTO photo_upload_file(batch_id,client_file_id,original_file_name,stored_file_name,content_type,file_size,staging_path,status,uploaded_at) VALUES(#{batchId},#{clientFileId},#{originalFileName},#{storedFileName},#{contentType},#{fileSize},#{stagingPath},'UPLOADED',#{uploadedAt})</insert>
 <update id="markCommitted">UPDATE photo_upload_batch SET status='COMMITTED',commit_request_id=#{commitRequestId},issue_id=#{issueId},committed_at=#{now} WHERE id=#{id} AND status='UPLOADING' AND expires_at&gt;#{now}</update>
 <select id="findExpiredBatches" resultMap="batch">SELECT * FROM photo_upload_batch WHERE status='UPLOADING' AND expires_at&lt;=#{now} ORDER BY expires_at LIMIT #{limit}</select>
 <update id="markBatchExpired">UPDATE photo_upload_batch SET status='EXPIRED' WHERE id=#{id} AND status='UPLOADING' AND expires_at&lt;=#{now}</update>
 <select id="findRetainedAttachmentPaths" resultType="string">SELECT storage_path FROM attachment_file WHERE deleted_at IS NULL</select>
 <select id="findRetainedStagingPaths" resultType="string">SELECT f.staging_path FROM photo_upload_file f JOIN photo_upload_batch b ON b.id=f.batch_id WHERE b.status='UPLOADING' AND f.status='UPLOADED'</select>
 <insert id="insertAudit">INSERT INTO audit_log(organization_id,farm_id,actor_user_id,action,target_type,target_id,detail_json,created_at) VALUES(#{organizationId},#{farmId},#{actorUserId},#{action},#{targetType},#{targetId},#{detailJson},#{now})</insert>
</mapper>
